[Unit]
Description=Ollama model runtime for Triade Omega
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenciadigitalwataboo
Group=agenciadigitalwataboo
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_MODELS=/teamspace/studios/this_studio/.ollama/models"
ExecStart=/teamspace/studios/this_studio/.ollama/runtime/bin/ollama serve
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/teamspace/studios/this_studio/.ollama /home/zeus/.ollama

[Install]
WantedBy=multi-user.target
