# Tríade Ω · perfil local de bajo consumo
# Objetivo de referencia: 8 GB RAM + NVIDIA 6 GB VRAM.
# Copiar solo las variables que correspondan al entorno real.

# Mantener el organismo vivo, pero limitar trabajo profundo de fondo.
TRIADE_ALWAYS_ON=true
TRIADE_ALWAYS_ON_MODE=light_background
TRIADE_WORKERS_ALWAYS_ON=true
TRIADE_WORKER_MODE=light_background

# Tríade libera el modelo después de cada inferencia. Puede cambiarse a 30s/60s
# si se prefiere menor latencia a costa de RAM/VRAM residente.
TRIADE_OLLAMA_KEEP_ALIVE=0

# Ollama: un solo modelo y una sola solicitud paralela.
OLLAMA_KEEP_ALIVE=0
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32

# 4K evita que el KV cache crezca innecesariamente en una máquina de 8 GB.
OLLAMA_CONTEXT_LENGTH=4096

# Reducen presión de memoria cuando el backend/GPU los soporta.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# La API sigue disponible aunque Ollama no esté cargado.
TRIADE_ALWAYS_ON_REQUIRE_OLLAMA=false
