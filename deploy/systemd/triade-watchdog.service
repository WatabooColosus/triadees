[Unit]
Description=Triade Omega progress watchdog
After=triade-workers.service

[Service]
Type=simple
User=triade
Group=triade
WorkingDirectory=/opt/triade
EnvironmentFile=/etc/triade/triade.env
ExecStart=/opt/triade/.venv/bin/python scripts/runtime_watchdog.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/triade/artifacts /opt/triade/runs /opt/triade/triade/memory

[Install]
WantedBy=multi-user.target
