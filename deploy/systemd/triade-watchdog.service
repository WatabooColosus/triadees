[Unit]
Description=Tríade Ω progress watchdog
Documentation=https://github.com/WatabooColosus/triadees
After=triade-api.service
Wants=triade-api.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Este watchdog NO reinicia el proceso de la API: de eso se ocupa systemd. Aquí
# se vigila que el organismo progrese por dentro (que el heartbeat avance) y se
# recuperan componentes internos. Separar las dos cosas evita el caso en que dos
# supervisores intentan reiniciar el mismo proceso a la vez.
Type=simple
User=agenciadigitalwataboo
Group=agenciadigitalwataboo
WorkingDirectory=/teamspace/studios/this_studio/triadees
Environment="PATH=/home/zeus/miniconda3/envs/cloudspace/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="HOME=/teamspace/studios/this_studio"
EnvironmentFile=-/teamspace/studios/this_studio/triadees/.env
ExecStart=/home/zeus/miniconda3/envs/cloudspace/bin/python scripts/runtime_watchdog.py
Restart=always
RestartSec=30
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/teamspace/studios/this_studio/triadees

[Install]
WantedBy=multi-user.target
