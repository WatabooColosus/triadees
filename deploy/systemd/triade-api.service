[Unit]
Description=Triade Omega governed API
After=network-online.target

[Service]
Type=simple
User=triade
Group=triade
WorkingDirectory=/opt/triade
EnvironmentFile=/etc/triade/triade.env
ExecStart=/opt/triade/.venv/bin/python -m uvicorn apps.single_port_app:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/triade/artifacts /opt/triade/runs /opt/triade/triade/memory

[Install]
WantedBy=multi-user.target
