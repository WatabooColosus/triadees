[Unit]
Description=Ollama model runtime for Tríade Ω
Documentation=https://github.com/WatabooColosus/triadees
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenciadigitalwataboo
Group=agenciadigitalwataboo
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_MODELS=/teamspace/studios/this_studio/.ollama/models"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_NUM_PARALLEL=1"
ExecStart=/teamspace/studios/this_studio/.ollama/runtime/bin/ollama serve
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/teamspace/studios/this_studio/.ollama

[Install]
WantedBy=multi-user.target
