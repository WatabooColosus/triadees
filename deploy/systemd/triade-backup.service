[Unit]
Description=Triade Omega encrypted verified backup

[Service]
Type=oneshot
User=triade
Group=triade
WorkingDirectory=/opt/triade
EnvironmentFile=/etc/triade/triade.env
ExecStart=/opt/triade/.venv/bin/python scripts/runtime_backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/triade/artifacts /opt/triade/triade/memory
