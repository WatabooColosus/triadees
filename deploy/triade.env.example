# Tríade Ω · Plantilla de /etc/triade/triade.env para despliegue local (systemd)
# Copiar a /etc/triade/triade.env y reemplazar los secretos. Nunca commitear
# el archivo real con TRIADE_API_KEY o TRIADE_BACKUP_KEY reales.
#
# Generar TRIADE_BACKUP_KEY con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

TRIADE_API_KEY=
TRIADE_CORS_ORIGINS=http://127.0.0.1:5678,http://localhost:5678
TRIADE_PUBLIC_GUARDED=false

# Always-On (triade/core/always_on.py) — decide el modo solicitado.
TRIADE_ALWAYS_ON=true
TRIADE_ALWAYS_ON_MODE=full_local_guarded
TRIADE_WORKERS_ALWAYS_ON=true
TRIADE_WORKERS_AUTOSTART=true
TRIADE_WORKERS_WATCHDOG=true
TRIADE_WORKER_MODE=full_local_guarded

# InternalRuntimeSupervisor (triade/services/supervisor.py) — eje de
# configuración INDEPENDIENTE de TRIADE_ALWAYS_ON_*. Si se omite, el
# supervisor cae a mode=observe_only/enabled=false por defecto sin importar
# lo que decida Always-On (hallazgo 2026-07-30, ver TECHNICAL_DEBT.md).
TRIADE_RUNTIME_MODE=full_local_guarded
TRIADE_RUNTIME_ENABLED=true

# Ollama
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=/teamspace/studios/this_studio/.ollama/models
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Python
PYTHONUNBUFFERED=1
TRIADE_STUDIO_PORT=8010

# Backup cifrado (scripts/runtime_backup.py) — clave Fernet, secreta.
TRIADE_BACKUP_KEY=replace-with-a-generated-fernet-key
