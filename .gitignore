# Artefactos de build. `pip install -e .` regenera `SOURCES.txt` con la lista
# de tests, asi que versionarlo hace que el arbol se ensucie solo en cuanto
# alguien anade uno: el gate `git diff --exit-code` de CI fallaba por esto sin
# que ningun cambio lo hubiera tocado.
*.egg-info/

# Entornos Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runs y memoria local
runs/
artifacts/
data/
.triade_trash/
triade/memory/triade.db
triade/memory/triade.db-*
# Cualquier variante de la base: copias apartadas, restauraciones a medias.
# El 2026-08-08 un `git add -A` intento subir una base corrupta de 221 MB
# porque el patron solo cubria `-wal` y `-shm`.
triade/memory/triade*.db
triade/memory/triade.db.*
triade/memory/public_relay.db
triade/memory/public_relay.db-*
triade/memory/local_node_tokens.json
*.sqlite
*.sqlite3

# Variables y secretos
.env
.env.*
*.key
*.pem
mobile_node_state.json
.triade-relay.tokens.local
apps/static/*.apk
backups/*.db
backups/*.sqlite
backups/*.sqlite3
.tools/
.codex-tools/
android/triade-node/.gradle/
android/triade-node/app/build/
android/triade-node/local.properties

# Sistema / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
logs/

# Android runtime artifacts local only
apps/static/android-runtime/
